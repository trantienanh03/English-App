# ============================================================
# Vocam — Unified .gitignore
# ============================================================

# IDE & OS
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# Temporary & Lock files
~$*
*.tmp
*.temp

# Environment Variables & Secrets (CRITICAL FOR SECURITY)
.env
.env.*
*.env
*.env.local
*.env.*.local
!.env.example
!*.env.example
credentials.json
*.pem
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
target/
dist/
build/
.expo/
web-build/
node_modules/

# Python Virtual Environments & Caches
venv/
.venv/
ai_service/venv/
**/venv/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# AI Model Binaries & Runs
*.pt
*.onnx
*.engine
runs/
clip/

# Custom AI Agent Skills & Configurations
.agents/

# Local Docs & Benchmark (Excluded from Public Repo)
Document/
benchmark/
*.docx
*.doc
*.pdf