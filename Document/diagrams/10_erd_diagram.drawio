<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="ERD Diagram" id="erd-vocam-v2-12tables">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Biểu đồ Quan hệ Thực thể (ERD) — Cơ sở dữ liệu Vocam (12 bảng)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#1A237E;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1700" height="40" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- ROW 1: user_profiles | words | lessons                -->
        <!-- ══════════════════════════════════════════════════════ -->

        <!-- user_profiles -->
        <mxCell id="tbl_up" value="user_profiles&#xa;────────────&#xa;* id : uuid [PK] ← Supabase Auth UID&#xa;  display_name : varchar(100)&#xa;  avatar_url : text&#xa;  role : varchar [LEARNER | ADMIN]&#xa;  status : varchar [ACTIVE | LOCKED]&#xa;  created_at : timestamptz&#xa;  updated_at : timestamptz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=12;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="320" height="160" as="geometry" />
        </mxCell>

        <!-- words -->
        <mxCell id="tbl_w" value="words&#xa;────────────&#xa;* id : bigint [PK, auto-increment]&#xa;* coco_class : varchar [UK] ← YOLO label&#xa;  en_word : varchar(100)&#xa;  phonetic : varchar(100) [IPA]&#xa;  pos : varchar(50) [Noun|Verb|Adj|Adv]&#xa;  definition : text&#xa;  translation : text&#xa;  example_en : text&#xa;  example_vn : text&#xa;  image_url : text ← Supabase Storage URL&#xa;  created_at : timestamptz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=12;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="80" width="330" height="220" as="geometry" />
        </mxCell>

        <!-- lessons -->
        <mxCell id="tbl_l" value="lessons&#xa;────────────&#xa;* id : bigint [PK, auto-increment]&#xa;  title : varchar(200)&#xa;  description : text&#xa;  topic : varchar(100)&#xa;  difficulty : varchar [EASY|MEDIUM|HARD]&#xa;  status : varchar [DRAFT | PUBLISHED]&#xa;  created_by : uuid [FK → user_profiles]&#xa;  created_at : timestamptz&#xa;  updated_at : timestamptz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=12;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="80" width="320" height="190" as="geometry" />
        </mxCell>

        <!-- badges -->
        <mxCell id="tbl_b" value="badges&#xa;────────────&#xa;* id : bigint [PK, auto-increment]&#xa;  name : varchar(100)&#xa;  description : text&#xa;  icon : varchar(10) [emoji]&#xa;  condition_type : varchar&#xa;    [STREAK|SCAN|WORDS_SAVED|QUIZ_PERFECT]&#xa;  condition_value : integer&#xa;  created_at : timestamptz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D6B656;align=left;spacingLeft=12;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1210" y="80" width="330" height="170" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- ROW 2: flashcards | user_progress | lesson_words      -->
        <!-- ══════════════════════════════════════════════════════ -->

        <!-- flashcards -->
        <mxCell id="tbl_f" value="flashcards&#xa;────────────&#xa;* id : uuid [PK]&#xa;+ user_id : uuid [FK → user_profiles]&#xa;+ word_id : bigint [FK → words]&#xa;  ease_factor : decimal(4,2) [default 2.5]&#xa;  interval_days : integer [default 1]&#xa;  repetitions : integer [default 0]&#xa;  next_review_at : timestamptz&#xa;  created_at : timestamptz&#xa;  updated_at : timestamptz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=12;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="320" height="200" as="geometry" />
        </mxCell>

        <!-- user_progress -->
        <mxCell id="tbl_prog" value="user_progress&#xa;────────────&#xa;* id : uuid [PK]&#xa;* user_id : uuid [UK, FK → user_profiles]&#xa;  total_xp : integer [default 0]&#xa;  level : integer [default 1]&#xa;  current_streak : integer [default 0]&#xa;  longest_streak : integer [default 0]&#xa;  words_learned : integer [default 0]&#xa;  last_study_at : timestamptz&#xa;  last_sync_at : timestamptz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=12;fontSize=11;fontStyle=1;" vertex="1" parent="1">
