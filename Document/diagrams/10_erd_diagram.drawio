        </mxCell>

        <!-- lesson_words (junction) -->
        <mxCell id="tbl_lw" value="lesson_words&#xa;────────────&#xa;* lesson_id : bigint [FK → lessons]&#xa;* word_id : bigint [FK → words]&#xa;  [PK: (lesson_id, word_id)]&#xa;  sort_order : integer&#xa;  created_at : timestamptz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=12;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="340" width="300" height="130" as="geometry" />
