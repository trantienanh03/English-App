        <mxCell id="jwt_filter" value="🛡️ JwtFilter (Spring Security)&#xa;― Kiểm tra chữ ký JWT Supabase&#xa;― Trích xuất Role: LEARNER / ADMIN&#xa;― Phân quyền endpoint API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#3949AB;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="spring_tier">
