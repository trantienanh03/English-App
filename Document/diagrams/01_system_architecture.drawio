        <mxCell id="fastapi_tier" value="🤖 FastAPI AI Microservice (Python 3.10 · Port 8000)" style="swimlane;startSize=36;horizontal=1;collapsible=0;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E64A19;fontStyle=1;fontSize=13;fontColor=#BF360C;" vertex="1" parent="1">
