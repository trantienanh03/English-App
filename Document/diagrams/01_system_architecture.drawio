        <!-- ═══════════════════════════════════════════════════ -->
        <!-- LAYER 2A: SUPABASE CLOUD TIER                      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <mxCell id="supabase_tier" value="☁️ Supabase Cloud Platform (External Backend-as-a-Service)" style="swimlane;startSize=36;horizontal=1;collapsible=0;rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontStyle=1;fontSize=13;fontColor=#0D47A1;" vertex="1" parent="1">
          <mxGeometry x="780" y="80" width="830" height="220" as="geometry" />
        </mxCell>

        <mxCell id="supa_auth" value="🔑 Supabase Auth&#xa;(Identity Service)&#xa;― Email + Password Login/SignUp&#xa;― Google OAuth 2.0&#xa;― Password Reset via Email&#xa;― Cấp JWT với sub = User UUID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="supabase_tier">
          <mxGeometry x="20" y="50" width="240" height="145" as="geometry" />
        </mxCell>

        <mxCell id="supa_db" value="🗄️ Managed PostgreSQL&#xa;(Database Source of Truth)&#xa;― 365 Canonical Words (words)&#xa;― Flashcards (saved_flashcards)&#xa;― Lesson Progress (user_lesson_progress)&#xa;― App Users (app_users)&#xa;― Flyway Migration (V100 → V107)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#0D47A1;fontStyle=1;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="supabase_tier">
          <mxGeometry x="280" y="45" width="270" height="155" as="geometry" />
        </mxCell>

        <mxCell id="supa_storage" value="🖼️ Supabase Storage&#xa;(Bucket: vocabulary-images)&#xa;― Lưu ảnh minh họa upload từ Admin&#xa;― Cấp Public Image URLs" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#0D47A1;fontStyle=1;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="supabase_tier">
          <mxGeometry x="570" y="50" width="240" height="145" as="geometry" />
        </mxCell>


        <!-- ═══════════════════════════════════════════════════ -->
        <!-- LAYER 2B: SPRING BOOT BACKEND & GATEWAY            -->
        <!-- ═══════════════════════════════════════════════════ -->
        <mxCell id="spring_tier" value="⚙️ Spring Boot Gateway &amp; Backend API (Java 17 · Spring Boot 3.3.4 · Port 8080)" style="swimlane;startSize=36;horizontal=1;collapsible=0;rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;fontStyle=1;fontSize=13;fontColor=#1A237E;" vertex="1" parent="1">
          <mxGeometry x="780" y="330" width="830" height="260" as="geometry" />
        </mxCell>

        <mxCell id="jwt_filter" value="🛡️ JwtFilter &amp; SecurityConfig&#xa;― Validates Supabase JWT Signature&#xa;― Extracts sub UUID claim&#xa;― Checks locked status (403 ACCOUNT_LOCKED)&#xa;― Enforces Server-side Security &amp; ROLE_ADMIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#3949AB;fontSize=10;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="spring_tier">
          <mxGeometry x="15" y="45" width="245" height="195" as="geometry" />
        </mxCell>

        <mxCell id="controllers" value="📦 Controllers &amp; Business Services&#xa;― ScanController (/api/scan → FastAPI)&#xa;― WordController (/api/words)&#xa;― FlashcardController (/api/flashcards &amp; SM-2 review)&#xa;― LessonController (/api/lessons)&#xa;― UserController (/api/me — wordsLearned check)&#xa;― AdminController (/api/admin/**)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#3949AB;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="spring_tier">
          <mxGeometry x="270" y="45" width="290" height="195" as="geometry" />
        </mxCell>

        <mxCell id="data_layer" value="🗃️ Data Access Layer&#xa;― Spring Data JPA / Hibernate&#xa;― HikariCP Connection Pool&#xa;― Flyway Schema Migrations&#xa;― Constraints: uk_saved_flashcard_user_word" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#3949AB;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="spring_tier">
          <mxGeometry x="570" y="45" width="245" height="195" as="geometry" />
        </mxCell>


        <!-- ═══════════════════════════════════════════════════ -->
        <!-- LAYER 2C: FASTAPI AI MICROSERVICE                  -->
        <!-- ═══════════════════════════════════════════════════ -->
        <mxCell id="fastapi_tier" value="🤖 FastAPI Internal AI Service (Python 3.10 · Port 8000)" style="swimlane;startSize=36;horizontal=1;collapsible=0;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E64A19;fontStyle=1;fontSize=13;fontColor=#BF360C;" vertex="1" parent="1">
          <mxGeometry x="780" y="620" width="830" height="220" as="geometry" />
        </mxCell>

        <mxCell id="yolo_node" value="👁️ Ultralytics YOLO-World v2&#xa;― Endpoint: POST /predict-multi&#xa;― Multi-object Detection&#xa;― 365 Canonical Objects365 Labels&#xa;― Returns Bounding Boxes + Labels + Confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E64A19;fontSize=10;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="fastapi_tier">
          <mxGeometry x="20" y="45" width="260" height="155" as="geometry" />
        </mxCell>

        <mxCell id="gemini_node" value="✨ Google Gemini 1.5 Flash AI&#xa;― Generates English-Vietnamese example sentences based on detected object context&#xa;― Fallback to predefined template if API times out or fails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E64A19;fontSize=10;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="fastapi_tier">
          <mxGeometry x="300" y="45" width="260" height="155" as="geometry" />
        </mxCell>

        <mxCell id="label_align" value="🔗 365 Label Alignment&#xa;― Deterministic 1-to-1 Mapping:&#xa;  FastAPI Objects365 Label&#xa;  == PostgreSQL detection_label&#xa;― Lowercase &amp; space normalization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E64A19;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="fastapi_tier">
          <mxGeometry x="580" y="45" width="230" height="155" as="geometry" />
        </mxCell>


