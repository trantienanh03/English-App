        <mxCell id="e_spring_db" value="JDBC / JPA Read &amp; Write Operations" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;fontStyle=1;strokeColor=#0D47A1;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="data_layer" target="supa_db">
