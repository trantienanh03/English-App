        </mxCell>

        <mxCell id="yolo_node" value="👁️ YOLO-World v2&#xa;(Ultralytics)&#xa;― POST /predict-multi&#xa;― Phát hiện đa vật thể&#xa;― 365 nhóm Objects365&#xa;― Bounding Box + Confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E64A19;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="fastapi_tier">
