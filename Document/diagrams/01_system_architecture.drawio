          <mxGeometry x="260" y="50" width="260" height="140" as="geometry" />
        </mxCell>

        <mxCell id="data_layer" value="🗃️ Data Access Layer&#xa;Spring Data JPA + Hibernate&#xa;Flyway DB Migration&#xa;JDBC → Supabase PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#3949AB;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="spring_tier">
