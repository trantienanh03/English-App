        <mxCell id="spring_tier" value="⚙️ Spring Boot Backend — Business Logic &amp; Core API (Java 21 · Spring Boot 3.3.4 · Port 8080)" style="swimlane;startSize=36;horizontal=1;collapsible=0;rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;fontStyle=1;fontSize=13;fontColor=#1A237E;" vertex="1" parent="1">
