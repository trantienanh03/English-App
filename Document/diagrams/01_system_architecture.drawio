        </mxCell>

        <!-- Centralized Client Network Services -->
        <mxCell id="api_client" value="Centralized HTTP API Client (src/services/api.ts)&#xa;― Tự động đính kèm Supabase JWT: Authorization: Bearer &lt;JWT&gt;&#xa;― Tự động Refresh Token khi 401 &amp; Xử lý 403 ACCOUNT_LOCKED (Auto Logout)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEDC8;strokeColor=#689F38;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="mobile_app">
          <mxGeometry x="15" y="512" width="630" height="65" as="geometry" />
