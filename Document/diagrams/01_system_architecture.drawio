        </mxCell>

        <mxCell id="gemini_node" value="✨ Google Gemini 1.5 Flash&#xa;(Generative AI)&#xa;― Sinh câu ví dụ Anh–Việt&#xa;― Theo ngữ cảnh vật thể nhận diện&#xa;― Template Fallback khi gián đoạn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E64A19;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="fastapi_tier">
