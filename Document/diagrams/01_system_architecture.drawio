          <mxGeometry x="20" y="50" width="250" height="140" as="geometry" />
        </mxCell>

        <mxCell id="supa_db" value="🗄️ Supabase PostgreSQL&#xa;(Managed Database)&#xa;― 12 bảng nghiệp vụ&#xa;― Flyway Migration (V100 → V102)&#xa;― Source of Truth tập trung" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#0D47A1;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="supabase_tier">
          <mxGeometry x="300" y="50" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="supa_storage" value="🖼️ Supabase Storage&#xa;(File Storage)&#xa;― Bucket: vocabulary-images&#xa;― Lưu ảnh minh họa từ Admin&#xa;― Trả về Public Image URL" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#0D47A1;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="supabase_tier">
          <mxGeometry x="570" y="50" width="240" height="140" as="geometry" />
