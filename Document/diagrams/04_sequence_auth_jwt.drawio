        <!-- ══════════════════════════════════════════════════ -->
        <!-- SECTION A: ĐĂNG NHẬP (Email + Password)           -->
        <!-- ══════════════════════════════════════════════════ -->
        <mxCell id="sec_a" value="A. Luồng Đăng nhập (Email + Password) — Supabase Auth xử lý" style="text;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;rounded=1;fontSize=12;fontStyle=1;fontColor=#0D47A1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="680" height="30" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="1. Nhập email + mật khẩu → nhấn Đăng nhập" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=1;strokeColor=#388E3C;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="85" y="210" as="sourcePoint" />
            <mxPoint x="310" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m2" value="2. signInWithPassword({ email, password })" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=1;strokeColor=#1565C0;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="240" as="sourcePoint" />
            <mxPoint x="570" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m3" value="3. Xác minh thông tin đăng nhập trong DB Supabase Auth" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;fontStyle=2;strokeColor=#512DA8;strokeWidth=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
