            <mxPoint x="1350" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m4" value="4. Tạo JWT Access Token { sub, role, email, exp }" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;fontStyle=2;strokeColor=#512DA8;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1350" y="300" as="sourcePoint" />
            <mxPoint x="570" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m5" value="5. { access_token, user } ← trả về App" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=1;strokeColor=#1565C0;strokeWidth=2;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="570" y="330" as="sourcePoint" />
            <mxPoint x="310" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m6" value="6. Lưu JWT Token vào AsyncStorage (cache phiên)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=1;strokeColor=#F9A825;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="360" as="sourcePoint" />
            <mxPoint x="830" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m7" value="7. Chuyển đến màn hình chính (Đăng nhập thành công)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=1;strokeColor=#388E3C;strokeWidth=2;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="390" as="sourcePoint" />
            <mxPoint x="85" y="390" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- SECTION B: GỌI API BẢO VỆ → SPRING SECURITY       -->
        <!-- ══════════════════════════════════════════════════ -->
        <mxCell id="sec_b" value="B. Luồng Gọi API được Bảo vệ — Spring Security JwtFilter Xác minh" style="text;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;rounded=1;fontSize=12;fontStyle=1;fontColor=#1A237E;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="1340" height="30" as="geometry" />
        </mxCell>

        <mxCell id="m8" value="8. Thực hiện thao tác (VD: Lưu flashcard, Đồng bộ XP)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=1;strokeColor=#388E3C;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="85" y="480" as="sourcePoint" />
            <mxPoint x="310" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m9" value="9. Lấy JWT từ AsyncStorage" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=1;strokeColor=#F9A825;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="510" as="sourcePoint" />
            <mxPoint x="830" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m9r" value="JWT Token" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#F9A825;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="830" y="535" as="sourcePoint" />
            <mxPoint x="310" y="535" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m10" value="10. POST /api/sync/progress&#xa;    Header: Authorization: Bearer &lt;JWT_ACCESS_TOKEN&gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=1;strokeColor=#3949AB;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="570" as="sourcePoint" />
            <mxPoint x="1095" y="570" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- JwtFilter box -->
        <mxCell id="jwt_box" value="JwtFilter xử lý:" style="swimlane;startSize=20;rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="590" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="jb1" value="① Trích xuất Token từ Header" style="text;html=1;fillColor=none;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="jwt_box">
          <mxGeometry x="10" y="25" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="jb2" value="② Xác minh chữ ký (Supabase JWT Secret)" style="text;html=1;fillColor=none;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="jwt_box">
          <mxGeometry x="10" y="48" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="jb3" value="③ Kiểm tra thời hạn (exp claim)" style="text;html=1;fillColor=none;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="jwt_box">
          <mxGeometry x="10" y="71" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="jb4" value="④ Trích xuất role → LEARNER / ADMIN" style="text;html=1;fillColor=none;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="jwt_box">
          <mxGeometry x="10" y="94" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="jb5" value="⑤ Set SecurityContextHolder (Authentication)" style="text;html=1;fillColor=none;fontSize=9;align=left;spacingLeft=5;fontStyle=1;" vertex="1" parent="jwt_box">
          <mxGeometry x="10" y="117" width="240" height="20" as="geometry" />
        </mxCell>

        <mxCell id="m11ok" value="11a. Token hợp lệ → Cho phép truy cập Service" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=1;strokeColor=#388E3C;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1095" y="770" as="sourcePoint" />
            <mxPoint x="1350" y="770" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m12" value="12. Đọc/Ghi dữ liệu nghiệp vụ" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#512DA8;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1095" y="790" as="sourcePoint" />
            <mxPoint x="1350" y="790" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m11err" value="11b. Token không hợp lệ / hết hạn → 401 Unauthorized" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=1;strokeColor=#D32F2F;strokeWidth=2;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1095" y="755" as="sourcePoint" />
            <mxPoint x="310" y="755" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Note -->
        <mxCell id="important_note" value="⚠️ QUAN TRỌNG:&#xa;Spring Boot KHÔNG tự sinh JWT.&#xa;Chỉ xác minh JWT do Supabase Auth cấp.&#xa;Không lưu Refresh Token trong DB riêng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCCCC;strokeColor=#D32F2F;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="650" width="290" height="100" as="geometry" />
